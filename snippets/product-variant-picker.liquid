{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant or product.variants.size <= 1 -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {%- if option.name == 'Title' -%}{{ 'products.product.select_variant' | t }}{%- else -%}{{ option.name }}{%- endif -%}:
            <span data-selected-value>
              {%- render 'option-value-label', value: option.selected_value -%}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        {%- comment -%}
          Minimum pill width is derived from the longest option value so labels never
          wrap mid-word. 0.75rem per character covers the widest real values measured
          on this store (uppercase SKU-style codes run ~0.73rem/char), plus 1.8rem of
          horizontal padding. The grid then fits as many equal columns as that minimum
          allows — see .variant-pills-grid in product-page-enhancements.css.
        {%- endcomment -%}
        {%- comment -%}
          Measured on the label the customer actually sees, not the stored value —
          an imported "%e2%88%85-1114-mm" is 18 characters but renders as 9.
        {%- endcomment -%}
        {%- assign longest_value = 0 -%}
        {%- for value in option.values -%}
          {%- capture value_label %}{% render 'option-value-label', value: value.name %}{% endcapture -%}
          {%- assign value_length = value_label | size -%}
          {%- if value_length > longest_value -%}
            {%- assign longest_value = value_length -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign pill_min = longest_value | times: 75 | plus: 180 | divided_by: 100.0 -%}
        {%- comment -%}
          The chip's second line carries the stock status, so the track has to fit
          that too — "Razprodano" is longer than a size like "77". Status text is
          1.05rem against the value's 1.2rem, hence 0.62rem/char rather than 0.75.
          No allowance for a dot: the chip status is text only, and reserving for
          a dot that no longer exists pushed 7 sizes onto two rows.
        {%- endcomment -%}
        {%- assign status_len = 'products.product.inventory_in_stock' | t | size -%}
        {%- assign sold_out_len = 'products.product.sold_out' | t | size -%}
        {%- if sold_out_len > status_len -%}
          {%- assign status_len = sold_out_len -%}
        {%- endif -%}
        {%- assign avail_len = 'products.product.stock_state.on_order' | t | size -%}
        {%- if avail_len > status_len -%}
          {%- assign status_len = avail_len -%}
        {%- endif -%}
        {%- assign status_min = status_len | times: 62 | plus: 180 | divided_by: 100.0 -%}
        {%- if status_min > pill_min -%}
          {%- assign pill_min = status_min -%}
        {%- endif -%}
        {%- if pill_min < 6 -%}
          {%- assign pill_min = 6 -%}
        {%- endif -%}
        {%- assign grid_id = section.id | append: '-opt' | append: option.position -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{%- if option.name == 'Title' -%}{{ 'products.product.select_variant' | t }}{%- else -%}{{ option.name }}{%- endif -%}</legend>
          <div class="variant-pills-grid" data-grid="{{ grid_id }}" style="--pill-min: {{ pill_min }}rem">
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          </div>
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {%- if option.name == 'Title' -%}{{ 'products.product.select_variant' | t }}{%- else -%}{{ option.name }}{%- endif -%}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- render 'variant-delivery-line', variant: product.selected_or_first_available_variant -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- else -%}
  {%- comment -%}
    A single-variant product has no chips to carry stock state, so without this it
    would show none of it — which is most of the accessories in this catalogue.
    The delivery line stands on its own here; there is no variant to follow, so it
    needs no <variant-selects> wrapper and no JS.
  {%- endcomment -%}
  {%- render 'variant-delivery-line', variant: product.selected_or_first_available_variant -%}
{%- endunless -%}
