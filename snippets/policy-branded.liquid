{{ 'section-main-blog-prepih.css' | asset_url | stylesheet_tag }}

<style>
  .policy-branded-padding {
    padding-top: 27px;
    padding-bottom: 27px;
  }

  @media screen and (min-width: 750px) {
    .policy-branded-padding {
      padding-top: 36px;
      padding-bottom: 36px;
    }
  }

  .policy-branded-content h3,
  .policy-branded-content h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, calc(var(--font-heading-scale) * 1.8rem), 2.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    line-height: 1.2;
  }

  .policy-branded-content h3:first-child,
  .policy-branded-content h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .policy-branded-content h4 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.1rem, calc(var(--font-heading-scale) * 1.3rem), 1.6rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    color: rgba(var(--color-foreground), 0.85);
    line-height: 1.3;
  }

  .policy-branded-content a {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .policy-branded-content a:hover {
    color: var(--color-brand-primary-dark);
  }

  /* Hide Shopify's default policy title and strip card wrapper */
  .policy-branded-content .shopify-policy__title {
    display: none;
  }

  .policy-branded-content .shopify-policy__container {
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .policy-branded-content .shopify-policy__body {
    padding: 0;
    margin: 0;
    border: none;
    box-shadow: none;
    background: none;
  }
</style>

<div class="page-width policy-branded-padding">

  <nav class="blog-prepih__breadcrumb" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
    <a href="/">{{ 'general.breadcrumbs.home' | t }}</a>
    <span class="blog-prepih__breadcrumb-sep" aria-hidden="true">/</span>
    <span class="blog-prepih__breadcrumb-current">{{ page_title }}</span>
  </nav>

  <div class="blog-prepih__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <h1 class="blog-prepih__title">{{ page_title | escape }}</h1>
  </div>

  <div class="rte policy-branded-content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ policy_content }}
  </div>

</div>
