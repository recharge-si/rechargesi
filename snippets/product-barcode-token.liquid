{% comment %}
  Renders variant SKU and Barcode (EAN) as label/value rows.
  Positioned at the top of the product info panel.
  Updates dynamically when the selected variant changes.

  Accepts:
    - product:    {Object} Product Liquid object
    - section_id: {String} Section ID for unique element IDs

  Usage:
    {%- render 'product-barcode-token', product: product, section_id: section.id -%}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sku_val     = current_variant.sku | default: ''
  assign barcode_val = current_variant.barcode | default: ''
-%}

<style>
  .pbt-wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pbt-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.07);
  }

  .pbt-row:first-child {
    border-top: 1px solid rgba(var(--color-foreground), 0.07);
  }

  .pbt-label {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(var(--color-foreground), 0.38);
    font-weight: 600;
    min-width: 6.5rem;
    flex-shrink: 0;
  }

  .pbt-value {
    font-size: 1.15rem;
    font-weight: 500;
    color: rgba(var(--color-foreground), 0.75);
    letter-spacing: 0.04em;
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
  }

  .pbt-value.pbt-empty {
    color: rgba(var(--color-foreground), 0.2);
    font-style: italic;
    font-weight: 400;
  }
</style>

<div
  class="pbt-wrap"
  id="ProductBarcodeToken-{{ section_id }}"
  data-section-id="{{ section_id }}"
>
  <div class="pbt-row">
    <span class="pbt-label">{{ 'products.product.sku_label' | t }}</span>
    <span
      class="pbt-value{% if sku_val == blank %} pbt-empty{% endif %}"
      id="PbtSku-{{ section_id }}"
    >{{- sku_val | default: '—' -}}</span>
  </div>
  <div class="pbt-row">
    <span class="pbt-label">{{ 'products.product.ean_label' | t }}</span>
    <span
      class="pbt-value{% if barcode_val == blank %} pbt-empty{% endif %}"
      id="PbtBarcode-{{ section_id }}"
    >{{- barcode_val | default: '—' -}}</span>
  </div>
</div>
