{% comment %}
  Renders the product's spec sheet: brand, catalogue category, the option
  values it comes in, then the selected variant's SKU and EAN.

  Only facts the store actually holds are printed — nothing is inferred from
  the description. Extra rows come from metafields listed in the block's
  "Spec rows" setting (one "Label | namespace.key" per line) and are skipped
  when a product has no value for them, so a row never shows an empty dash.

  The wrapper id is load-bearing: product-info.js swaps
  #ProductBarcodeToken-{section} on every variant change, which keeps SKU and
  EAN in step with the selected size. Rename it and they freeze.

  Accepts:
    - product:    {Object} Product Liquid object
    - section_id: {String} Section ID for unique element IDs
    - block:      {Object} The barcode_token block (optional; for spec rows)
    - trail:      {Array}  Category trail as [title, url] pairs, deepest last (optional)

  Usage:
    {%- render 'product-barcode-token', product: product, section_id: section.id, block: block, trail: trail -%}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sku_val = current_variant.sku | default: ''
  assign barcode_val = current_variant.barcode | default: ''
  assign spec_lines = block.settings.spec_rows | newline_to_br | split: '<br />'
-%}

<div
  class="pbt-wrap rc-spec"
  id="ProductBarcodeToken-{{ section_id }}"
  data-section-id="{{ section_id }}"
>
  <h2 class="rc-spec__title">{{ 'products.product.specs.title' | t }}</h2>
  <dl class="rc-spec__list">
    {%- if product.vendor != blank -%}
      <div class="rc-spec__row">
        <dt>{{ 'products.product.specs.brand' | t }}</dt>
        <dd>{{ product.vendor | link_to_vendor }}</dd>
      </div>
    {%- endif -%}

    {%- if trail.size > 0 -%}
      <div class="rc-spec__row">
        <dt>{{ 'products.product.specs.category' | t }}</dt>
        <dd>
          {%- for step in trail -%}
            {%- assign step_parts = step | split: '||' -%}
            <a href="{{ step_parts[1] }}">{{ step_parts[0] | escape }}</a>
            {%- unless forloop.last %} / {% endunless -%}
          {%- endfor -%}
        </dd>
      </div>
    {%- endif -%}

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        <div class="rc-spec__row">
          <dt>{{ option.name | escape }}</dt>
          <dd>
            {%- for option_value in option.values -%}
              {%- capture ov_label %}{% render 'option-value-label', value: option_value %}{% endcapture -%}
              {{- ov_label | strip | escape -}}
              {%- unless forloop.last %} · {% endunless -%}
            {%- endfor -%}
          </dd>
        </div>
      {%- endfor -%}
    {%- endunless -%}

    {%- for line in spec_lines -%}
      {%- assign spec_parts = line | strip_newlines | split: '|' -%}
      {%- if spec_parts.size == 2 -%}
        {%- liquid
          assign spec_label = spec_parts[0] | strip
          assign spec_path = spec_parts[1] | strip | split: '.'
          assign spec_value = nil
          if spec_path.size == 2
            assign spec_value = product.metafields[spec_path[0]][spec_path[1]]
          endif
        -%}
        {%- if spec_value != blank -%}
          <div class="rc-spec__row">
            <dt>{{ spec_label | escape }}</dt>
            <dd>{{ spec_value | metafield_tag }}</dd>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="rc-spec__row">
      <dt>{{ 'products.product.sku_label' | t | remove: ':' }}</dt>
      <dd class="rc-spec__code{% if sku_val == blank %} rc-spec__code--empty{% endif %}" id="PbtSku-{{ section_id }}">
        {{- sku_val | default: '—' -}}
      </dd>
    </div>
    <div class="rc-spec__row">
      <dt>{{ 'products.product.ean_label' | t | remove: ':' }}</dt>
      <dd class="rc-spec__code{% if barcode_val == blank %} rc-spec__code--empty{% endif %}" id="PbtBarcode-{{ section_id }}">
        {{- barcode_val | default: '—' -}}
      </dd>
    </div>
  </dl>
</div>
