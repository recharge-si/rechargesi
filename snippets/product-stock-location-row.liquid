{% comment %}
  Renders one row of the stock-by-location table.

  Accepts:
    - name:            {String}  Location name
    - detail:          {String}  Optional second line — address and/or note
    - has_counts:      {Boolean} True when a quantity is known for this row
    - quantity:        {Number}  Units on hand (used when has_counts)
    - available:       {Boolean} In stock yes/no (used when has_counts is false)
    - low_threshold:   {Number}  At or below this, the row reads "last few"
    - full_threshold:  {Number}  Quantity that fills all five gauge ticks

  Usage:
    {%- render 'product-stock-location-row', name: entry.name, detail: detail,
        has_counts: true, quantity: entry.quantity,
        low_threshold: low_threshold, full_threshold: full_threshold -%}
{% endcomment %}

{%- liquid
  if has_counts
    assign qty = quantity | plus: 0
    if qty <= 0
      assign state = 'out'
      assign state_label = 'products.product.stock_locations.out_of_stock' | t
    elsif qty <= low_threshold
      assign state = 'low'
      assign state_label = 'products.product.stock_locations.low_stock' | t
    else
      assign state = 'in'
      assign state_label = 'products.product.stock_locations.in_stock' | t
    endif

    assign filled = qty | times: 5.0 | divided_by: full_threshold | ceil
    if filled > 5
      assign filled = 5
    endif
  else
    if available
      assign state = 'in'
      assign state_label = 'products.product.stock_locations.in_stock' | t
    else
      assign state = 'out'
      assign state_label = 'products.product.stock_locations.out_of_stock' | t
    endif
  endif
-%}

<tr class="stock-row stock-row--{{ state }}">
  <th scope="row" class="stock-row__location">
    <span class="stock-row__name">{{ name | escape }}</span>
    {%- if detail != blank -%}
      <span class="stock-row__meta">{{ detail | escape }}</span>
    {%- endif -%}
  </th>
  <td class="stock-row__status">
    <span class="stock-dot" aria-hidden="true"></span>{{ state_label }}
  </td>
  {%- if has_counts -%}
    <td class="stock-row__qty">
      <span class="stock-meter" aria-hidden="true">
        {%- for i in (1..5) -%}
          <span
            class="stock-meter__seg{% if forloop.index <= filled %} is-filled{% endif %}"
            style="--seg-index: {{ forloop.index0 }}"
          ></span>
        {%- endfor -%}
      </span>
      <span class="stock-qty">{{ qty }}</span>
    </td>
  {%- endif -%}
</tr>
