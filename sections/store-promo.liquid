{{ 'component-brand-button.css' | asset_url | stylesheet_tag }}
{{ 'section-store-promo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign image = section.settings.image -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="store-promo color-{{ section.settings.color_scheme }} gradient">
    <div class="store-promo__media">
      {%- if image != blank -%}
        {%- assign image_style = 'object-position: ' | append: image.presentation.focal_point | append: ';' -%}
        {{
          image
          | image_url: width: 1400
          | image_tag:
            widths: '375, 550, 750, 1000, 1400',
            sizes: '(min-width: 1400px) 560px, (min-width: 990px) 42vw, 100vw',
            loading: 'lazy',
            style: image_style
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="store-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="store-promo__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="home-heading store-promo__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="store-promo__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.address != blank -%}
        <p class="store-promo__address">
          <span class="store-promo__pin" aria-hidden="true">{{- 'icon-map-pin.svg' | inline_asset_content -}}</span>
          <span>{{ section.settings.address | escape }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--brand store-promo__button"
        >
          {{- section.settings.button_label | escape -}}
          <span class="button__arrow" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store promo",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown square. Set a focal point to control cropping."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visit our store"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Recharge has moved"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Come see us at our new location — a bigger space, a wider range, and the same Recharge you know.</p>"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "e.g. a Google Maps link to the store."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Store promo"
    }
  ]
}
{% endschema %}
