{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

{%- comment -%}
  Walks the header menu to find where this collection sits in the catalogue,
  so the breadcrumb and the sub-navigation both come from the same source the
  mega menu uses. The page is then one step deeper into the structure the
  customer just navigated, not a generic collection template.
{%- endcomment -%}
{%- liquid
  assign bc_l1 = nil
  assign bc_l2 = nil
  assign bc_current_title = ''
  assign bc_depth = -1
  assign bc_found = false

  assign col_url_check = '|' | append: collection.url | append: '|'
  assign main_menu = linklists['recharge-menu']

  for link in main_menu.links
    for childlink in link.links
      for grandchildlink in childlink.links
        assign gc_check = '|' | append: grandchildlink.url | append: '|'
        if bc_found == false and gc_check == col_url_check
          assign bc_l1 = link
          assign bc_l2 = childlink
          assign bc_current_title = grandchildlink.title
          assign bc_depth = 2
          assign bc_found = true
        endif
      endfor

      unless bc_found
        assign cl_check = '|' | append: childlink.url | append: '|'
        if cl_check == col_url_check
          assign bc_l1 = link
          assign bc_l2 = childlink
          assign bc_current_title = childlink.title
          assign bc_depth = 1
          assign bc_found = true
        endif
      endunless
    endfor

    unless bc_found
      assign l_check = '|' | append: link.url | append: '|'
      if l_check == col_url_check
        assign bc_l1 = link
        assign bc_current_title = link.title
        assign bc_depth = 0
        assign bc_found = true
      endif
    endunless
  endfor

  if bc_current_title == blank
    assign bc_current_title = collection.title
  endif

  # Sub-navigation: the level below this collection (Boards -> its
  # disciplines), or, on a discipline page, its siblings so the customer can
  # move sideways. "All" is the parent level. Only short lists: a sport's
  # 14 categories, or a leaf like Footstraps falling back to all of them, is
  # a second navigation bar, not a sub-navigation - the mega menu has those.
  assign subnav_parent = nil
  case bc_depth
    when 0
      assign subnav_parent = bc_l1
    when 1
      if bc_l2.links.size > 0
        assign subnav_parent = bc_l2
      endif
    when 2
      assign subnav_parent = bc_l2
  endcase
  if subnav_parent != nil and subnav_parent.links.size > 8
    assign subnav_parent = nil
  endif
-%}

<div class="rc-page-head page-width">
  <nav class="rc-crumbs" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    {%- if bc_depth >= 1 -%}
      <span class="rc-crumbs__sep" aria-hidden="true">/</span>
      <a href="{{ bc_l1.url }}">{{ bc_l1.title | escape }}</a>
    {%- endif -%}
    {%- if bc_depth >= 2 -%}
      <span class="rc-crumbs__sep" aria-hidden="true">/</span>
      <a href="{{ bc_l2.url }}">{{ bc_l2.title | escape }}</a>
    {%- endif -%}
    <span class="rc-crumbs__sep" aria-hidden="true">/</span>
    <span class="rc-crumbs__current" aria-current="page">{{ bc_current_title | escape }}</span>
  </nav>

  <h1 class="rc-page-title">{{ bc_current_title | escape }}</h1>

  {%- if section.settings.show_collection_description and collection.description != blank -%}
    <div class="collection-hero__description rte">{{ collection.description }}</div>
  {%- endif -%}
</div>

{%- if subnav_parent != nil and subnav_parent.links.size > 1 -%}
  <nav class="rc-subnav page-width" aria-label="{{ subnav_parent.title | escape }}">
    <ul class="rc-subnav__list" role="list">
      <li class="rc-subnav__item">
        <a
          href="{{ subnav_parent.url }}"
          class="rc-subnav__link"
          {% if subnav_parent.url == collection.url %}
            aria-current="page"
          {% endif %}
        >
          {{- 'sections.collection_subnav.all' | t -}}
        </a>
      </li>
      {%- for sublink in subnav_parent.links -%}
        <li class="rc-subnav__item">
          <a
            href="{{ sublink.url }}"
            class="rc-subnav__link"
            {% if sublink.url == collection.url %}
              aria-current="page"
            {% endif %}
          >
            {{- sublink.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{%- if section.settings.show_collection_image and collection.image -%}
  <div class="collection-hero collection-hero--with-image color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
