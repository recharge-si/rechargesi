{{ 'section-hero-banner-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banners = section.blocks | where: "type", "banner"
-%}

<div class="page-width">
<hero-banner-grid
  class="hero-banner-grid"
  data-auto-rotate="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.rotation_speed }}"
>
  {%- comment -%} Left: Main display area {%- endcomment -%}
  <div class="hero-banner-grid__main">
    {%- for block in banners -%}
      <div
        class="hero-banner-grid__main-item{% if forloop.first %} hero-banner-grid__main-item--active{% endif %}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
            assign fetch_priority = 'auto'
            if section.index == 1 and forloop.first
              assign fetch_priority = 'high'
            endif
          -%}
          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}" class="hero-banner-grid__main-link">
          {%- endif -%}
            {%- if forloop.first -%}
              {{ block.settings.image | image_url: width: 3840 | image_tag:
                class: 'hero-banner-grid__image',
                height: height,
                sizes: '100vw',
                widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000',
                fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 3840 | image_tag:
                class: 'hero-banner-grid__image',
                loading: 'lazy',
                height: height,
                sizes: '100vw',
                widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000'
              }}
            {%- endif -%}
          {%- if block.settings.url != blank -%}
            </a>
          {%- endif -%}
        {%- else -%}
          <div class="hero-banner-grid__placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if banners.size == 0 -%}
      {%- for i in (1..3) -%}
        <div class="hero-banner-grid__main-item{% if forloop.first %} hero-banner-grid__main-item--active{% endif %}" data-index="{{ forloop.index0 }}">
          <div class="hero-banner-grid__placeholder">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</hero-banner-grid>
</div>

<script>
  if (!customElements.get('hero-banner-grid')) {
    class HeroBannerGrid extends HTMLElement {
      constructor() {
        super();
        this.mainItems = this.querySelectorAll('.hero-banner-grid__main-item');
        this.activeIndex = 0;
        this.autoRotate = this.dataset.autoRotate === 'true';
        this.speed = parseInt(this.dataset.speed, 10) * 1000 || 5000;
        this.timer = null;
      }

      connectedCallback() {
        if (this.mainItems.length === 0) return;
        this.mainEl = this.querySelector('.hero-banner-grid__main');

        /* Set initial height once first image loads */
        this.updateHeight();
        const firstImg = this.mainItems[0]?.querySelector('img');
        if (firstImg) {
          if (firstImg.complete) this.updateHeight();
          else firstImg.addEventListener('load', () => this.updateHeight(), { once: true });
        }

        this._resizeObserver = new ResizeObserver(() => this.updateHeight());
        this._resizeObserver.observe(this.mainEl);

        if (this.autoRotate && this.mainItems.length > 1) {
          this.startTimer();
        }
      }

      disconnectedCallback() {
        this.stopTimer();
        if (this._resizeObserver) this._resizeObserver.disconnect();
      }

      updateHeight() {
        const active = this.mainItems[this.activeIndex];
        if (!active) return;
        const img = active.querySelector('img');
        if (img && img.naturalHeight) {
          const w = this.mainEl.offsetWidth;
          const h = w / (img.naturalWidth / img.naturalHeight);
          this.mainEl.style.height = h + 'px';
        }
      }

      goTo(index) {
        this.mainItems[this.activeIndex]?.classList.remove('hero-banner-grid__main-item--active');
        this.activeIndex = index;
        this.mainItems[this.activeIndex]?.classList.add('hero-banner-grid__main-item--active');
        this.updateHeight();
      }

      next() {
        const nextIndex = (this.activeIndex + 1) % this.mainItems.length;
        this.goTo(nextIndex);
      }

      startTimer() {
        this.stopTimer();
        if (!this.autoRotate) return;
        this.timer = setInterval(() => this.next(), this.speed);
      }

      stopTimer() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
      }
    }

    customElements.define('hero-banner-grid', HeroBannerGrid);
  }
</script>

{% schema %}
{
  "name": "Hero Banner Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate banners",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change banner every",
      "default": 5
    },
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Grid",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
