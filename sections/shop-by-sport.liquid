{{ 'section-shop-by-sport.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign feature_first = false
  if section.settings.feature_first and section.blocks.size >= 3
    assign feature_first = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="shop-by-sport page-width rc-section rc-section--{{ section.settings.spacing }}">
    {%- if section.settings.heading != blank -%}
      <div class="rc-section-head">
        <h2 class="rc-section-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ul
      class="shop-by-sport__list{% if feature_first %} shop-by-sport__list--featured{% endif %}"
      style="--tile-count: {{ section.blocks.size | at_least: 1 }};"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign label = block.settings.label | default: collection.title
          assign image = block.settings.image | default: collection.featured_image
          if label == blank
            assign label = 'onboarding.collection_title' | t
          endif
          assign is_feature = false
          if feature_first and forloop.first
            assign is_feature = true
          endif
        -%}
        <li class="shop-by-sport__item{% if is_feature %} shop-by-sport__item--feature{% endif %}" {{ block.shopify_attributes }}>
          <a
            {% if collection != blank %}
              href="{{ collection.url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="shop-by-sport__tile rc-sweep"
          >
            <span class="shop-by-sport__media">
              {%- if image != blank -%}
                {%- liquid
                  assign image_style = 'object-position: ' | append: image.presentation.focal_point | append: ';'
                  if is_feature
                    assign image_sizes = '(min-width: 1400px) 660px, (min-width: 750px) 50vw, 100vw'
                  else
                    assign image_sizes = '(min-width: 1400px) 330px, (min-width: 750px) 25vw, 50vw'
                  endif
                -%}
                {{
                  image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '300, 450, 600, 750, 900, 1100, 1400',
                    sizes: image_sizes,
                    loading: 'lazy',
                    alt: '',
                    style: image_style
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="shop-by-sport__label">
              <span class="shop-by-sport__text">
                <span class="shop-by-sport__name">{{- label | escape -}}</span>
                {%- if section.settings.show_count and collection.all_products_count > 0 -%}
                  <span class="shop-by-sport__count">
                    {{- 'products.facets.product_count_simple' | t: count: collection.all_products_count -}}
                  </span>
                {%- endif -%}
              </span>
              <span class="shop-by-sport__arrow rc-arrow" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by sport",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by sport"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "Feature the first category",
      "info": "Shows the first category as a large tile, the rest beside it. Use it for the core sport.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "info": "Uses the site-wide section rhythm.",
      "options": [
        { "value": "flush", "label": "None" },
        { "value": "tight", "label": "Tight — same chapter" },
        { "value": "default", "label": "Default — new chapter" },
        { "value": "large", "label": "Large — new subject" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image. Set a focal point to control cropping."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by sport",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
