<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .branded-breadcrumb {
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.4);
    margin-bottom: 2rem;
  }

  .branded-breadcrumb a {
    color: rgba(var(--color-foreground), 0.4);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .branded-breadcrumb a:hover {
    color: var(--color-brand-primary);
  }

  .branded-breadcrumb__sep {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .branded-breadcrumb__current {
    color: rgba(var(--color-foreground), 0.6);
  }

  .branded-header {
    margin-bottom: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .branded-header {
      margin-bottom: 3.6rem;
    }
  }

  .branded-header__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, calc(var(--font-heading-scale) * 3rem), 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
    color: rgb(var(--color-foreground));
    word-break: break-word;
  }

  @media screen and (min-width: 750px) {
    .branded-header__title {
      font-size: calc(var(--font-heading-scale) * 4rem);
    }
  }

  .branded-header__title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 3px;
    background: var(--color-brand-primary);
    margin-top: 1.2rem;
  }

  .branded-content h3 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, calc(var(--font-heading-scale) * 1.8rem), 2.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    line-height: 1.2;
  }

  .branded-content h3:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .branded-content h4 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.1rem, calc(var(--font-heading-scale) * 1.3rem), 1.6rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    color: rgba(var(--color-foreground), 0.85);
    line-height: 1.3;
  }

  .branded-content p,
  .branded-content br + br {
    margin-bottom: 0;
  }

  .branded-content a {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .branded-content a:hover {
    color: var(--color-brand-primary-dark);
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">

    <nav class="branded-breadcrumb" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
      <a href="/">{{ 'general.breadcrumbs.home' | t }}</a>
      <span class="branded-breadcrumb__sep" aria-hidden="true">/</span>
      <span class="branded-breadcrumb__current">{{ page.title }}</span>
    </nav>

    <div class="branded-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="branded-header__title">{{ page.title | escape }}</h1>
    </div>

    <div class="rte branded-content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Branded page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
