{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rig-builder.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'rig_builder.heading' | t
  endif
  assign intro = section.settings.intro
  if intro == blank
    assign intro = 'rig_builder.intro' | t
  endif
  assign fallback = section.settings.collection
  if section.settings.contact_url != blank
    assign contact_url = section.settings.contact_url
  elsif shop.email != blank
    assign contact_url = 'mailto:' | append: shop.email
  else
    assign contact_url = routes.root_url
  endif
  assign locale_code = request.locale.iso_code
-%}

<div class="rig-builder-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <rig-builder
      class="rig-builder"
      data-proxy-base="/apps/rig"
      data-locale="{{ locale_code }}"
      data-currency="{{ cart.currency.iso_code }}"
      data-section-id="{{ section.id }}"
    >
      <h1 class="rig-builder__title">{{ heading | escape }}</h1>
      <p class="rig-builder__lead">{{ intro | escape }}</p>

      <div class="rig-builder__split" data-split>
        <form class="rig-builder__form" data-form novalidate>
          <h2 class="rig-builder__h2">{{ 'rig_builder.about_you' | t }}</h2>

          <div class="rig-builder__row">
            <div>
              <label class="rig-builder__label" for="Rig-Weight-{{ section.id }}">{{ 'rig_builder.weight' | t }}</label>
              <input
                class="rig-builder__input"
                id="Rig-Weight-{{ section.id }}"
                name="weightKg"
                type="number"
                inputmode="numeric"
                min="30"
                max="200"
                step="1"
                autocomplete="off"
                data-field="weightKg"
                aria-describedby="Rig-Weight-Hint-{{ section.id }}"
              >
            </div>
            <div>
              <label class="rig-builder__label" for="Rig-Level-{{ section.id }}">{{ 'rig_builder.level' | t }}</label>
              <select class="rig-builder__input rig-builder__select" id="Rig-Level-{{ section.id }}" name="skill" data-field="skill">
                <option value="intermediate" selected>{{ 'rig_builder.level_improving' | t }}</option>
                <option value="beginner">{{ 'rig_builder.level_start' | t }}</option>
                <option value="advanced">{{ 'rig_builder.level_confident' | t }}</option>
              </select>
            </div>
          </div>
          <p class="rig-builder__hint" id="Rig-Weight-Hint-{{ section.id }}" data-hint="weightKg" hidden>{{ 'rig_builder.hint_weight' | t }}</p>

          <div class="rig-builder__row">
            <div>
              <label class="rig-builder__label" for="Rig-WindMin-{{ section.id }}">{{ 'rig_builder.wind_from' | t }}</label>
              <input
                class="rig-builder__input"
                id="Rig-WindMin-{{ section.id }}"
                name="windMinKn"
                type="number"
                inputmode="numeric"
                min="0"
                max="60"
                step="1"
                value="15"
                autocomplete="off"
                data-field="windMinKn"
                aria-describedby="Rig-Wind-Hint-{{ section.id }}"
              >
            </div>
            <div>
              <label class="rig-builder__label" for="Rig-WindMax-{{ section.id }}">{{ 'rig_builder.wind_to' | t }}</label>
              <input
                class="rig-builder__input"
                id="Rig-WindMax-{{ section.id }}"
                name="windMaxKn"
                type="number"
                inputmode="numeric"
                min="0"
                max="60"
                step="1"
                value="25"
                autocomplete="off"
                data-field="windMaxKn"
                aria-describedby="Rig-Wind-Hint-{{ section.id }}"
              >
            </div>
          </div>
          <p class="rig-builder__hint" id="Rig-Wind-Hint-{{ section.id }}" data-hint="wind" hidden>{{ 'rig_builder.hint_wind' | t }}</p>

          <div class="rig-builder__label" id="Rig-Owns-Label-{{ section.id }}">{{ 'rig_builder.already_own' | t }}</div>
          <div class="rig-builder__chips" role="group" aria-labelledby="Rig-Owns-Label-{{ section.id }}">
            {%- for role in 'board,sail,boom,fin' split: ',' -%}
              {%- assign own_key = 'rig_builder.own_' | append: role -%}
              <button type="button" class="rig-builder__chip" aria-pressed="false" data-own="{{ role }}">{{ own_key | t }}</button>
            {%- endfor -%}
          </div>

          <label class="rig-builder__label" for="Rig-Text-{{ section.id }}">{{ 'rig_builder.or_tell' | t }}</label>
          <textarea
            class="rig-builder__input rig-builder__textarea"
            id="Rig-Text-{{ section.id }}"
            name="text"
            maxlength="1000"
            rows="4"
            placeholder="{{ 'rig_builder.text_placeholder' | t | escape }}"
            aria-describedby="Rig-Counter-{{ section.id }} Rig-Privacy-{{ section.id }}"
            data-text
          ></textarea>
          <div class="rig-builder__counter" id="Rig-Counter-{{ section.id }}" data-counter>0 / 1000</div>
          <p class="rig-builder__privacy" id="Rig-Privacy-{{ section.id }}">{{ 'rig_builder.privacy' | t }}</p>

          <div class="rig-builder__actions">
            <button type="submit" class="rig-builder__btn" data-build>{{ 'rig_builder.build' | t }}</button>
            <button type="button" class="rig-builder__btn rig-builder__btn--ghost" data-read disabled>{{ 'rig_builder.read_text' | t }}</button>
          </div>
        </form>

        <div class="rig-builder__side">
          <p class="rig-builder__note" data-empty>{{ 'rig_builder.empty_note' | t }}</p>
          <div
            class="rig-builder__results"
            data-results
            aria-live="polite"
            aria-busy="false"
            tabindex="-1"
            hidden
          ></div>
        </div>
      </div>

      <div class="rig-builder__note rig-builder__notready" data-notready role="status" hidden>
        <p class="rig-builder__notready-title">{{ 'rig_builder.not_ready_title' | t }}</p>
        {%- capture browse_link -%}
          {%- if fallback != blank -%}
            <a href="{{ fallback.url }}">{{ fallback.title | escape }}</a>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}">{{ 'rig_builder.not_ready_shop' | t }}</a>
          {%- endif -%}
        {%- endcapture -%}
        {%- capture write_link -%}
          <a href="{{ contact_url }}">{{ 'rig_builder.not_ready_write' | t }}</a>
        {%- endcapture -%}
        <p>{{ 'rig_builder.not_ready_body_html' | t: browse: browse_link, write: write_link }}</p>
      </div>

      <script type="application/json" data-strings>
        {
          "role_board": {{ 'rig_builder.role_board' | t | json }},
          "role_sail": {{ 'rig_builder.role_sail' | t | json }},
          "role_mast": {{ 'rig_builder.role_mast' | t | json }},
          "role_extension": {{ 'rig_builder.role_extension' | t | json }},
          "role_boom": {{ 'rig_builder.role_boom' | t | json }},
          "role_base": {{ 'rig_builder.role_base' | t | json }},
          "role_fin": {{ 'rig_builder.role_fin' | t | json }},
          "role_harness": {{ 'rig_builder.role_harness' | t | json }},
          "kind_freeride": {{ 'rig_builder.kind_freeride' | t | json }},
          "kind_wave": {{ 'rig_builder.kind_wave' | t | json }},
